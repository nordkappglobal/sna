# Public values bundled into the admin login page.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret. Never prefix this with VITE_.
SUPABASE_SECRET_KEY=

# Private Google Sheet integration.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads_SNA

# Preferred free email integration: Google Apps Script bound to the lead Sheet.
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
GOOGLE_APPS_SCRIPT_WEBHOOK_SECRET=

# Recipient list (comma-separated). If empty, active admin emails are used.
LEAD_NOTIFICATION_TO=

# Optional fallback email integration (Resend).
RESEND_API_KEY=
LEAD_EMAIL_FROM=SNA CCA <leads@example.com>
ADMIN_BASE_URL=https://example.com/admin/
